# Legacy stacks (deprecated)
./archived/
./backend-storage/container_volume_persist/*
./backend-storage/.env
./tracking-server/.env

# Platform environment files
platform/env/.env.local
platform/env/*.local

# Platform local volumes
platform/volumes/

# TLS certificates (never commit private keys!)
platform/services/proxy/certs/*.crt
platform/services/proxy/certs/*.key
platform/services/proxy/certs/*.pem

# NGINX auth files (contains hashed passwords)
platform/services/proxy/.htpasswd

# Docker volumes and temporary files
*.log
*.tmp