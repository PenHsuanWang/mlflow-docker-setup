# Base environment configuration for MLflow platform
# This file contains non-sensitive default values

# MySQL Configuration
MYSQL_DATABASE=mlflow
MYSQL_USER=mlflow
MYSQL_PASSWORD=mlflow_default_password

# MLflow Backend Configuration
MLFLOW_BACKEND_STORE_URI=mysql+pymysql://mlflow:mlflow_default_password@db:3306/mlflow

# MLflow Artifact Configuration
MLFLOW_ARTIFACT_ROOT=http://artifact:5500/api/2.0/mlflow-artifacts/artifacts

# Gunicorn Configuration
GUNICORN_LOG_LEVEL=info

# Network Configuration
COMPOSE_PROJECT_NAME=mlflow-platform
