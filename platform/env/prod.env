# Production environment configuration
# Extends base.env with production-specific settings
# 
# IMPORTANT: Do not commit this file with real credentials!
# Copy this to .env.local and update with your production values

# MySQL Root Password
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# MySQL Configuration
MYSQL_PASSWORD=CHANGE_ME_STRONG_MLFLOW_PASSWORD

# MLflow Backend (use production credentials)
MLFLOW_BACKEND_STORE_URI=mysql+pymysql://mlflow:CHANGE_ME_STRONG_MLFLOW_PASSWORD@db:3306/mlflow

# Production logging
GUNICORN_LOG_LEVEL=warning

# NGINX Authentication
MLFLOW_TRACKING_USERNAME=CHANGE_ME_USERNAME
MLFLOW_TRACKING_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Network Configuration
COMPOSE_PROJECT_NAME=mlflow-prod

# TLS Configuration (set to true when certificates are configured)
NGINX_TLS_ENABLED=false
