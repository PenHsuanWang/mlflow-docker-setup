# Development environment configuration
# Extends base.env with development-specific settings

# MySQL Root Password (dev only)
MYSQL_ROOT_PASSWORD=root_dev_password

# MySQL Configuration (override for dev)
MYSQL_PASSWORD=mlflow_dev_password

# MLflow Backend (use dev credentials)
MLFLOW_BACKEND_STORE_URI=mysql+pymysql://mlflow:mlflow_dev_password@db:3306/mlflow

# MLflow Artifact Configuration
MLFLOW_ARTIFACT_ROOT=http://artifact:5500/api/2.0/mlflow-artifacts/artifacts

# Enable debug logging
GUNICORN_LOG_LEVEL=debug

# NGINX Authentication (dev credentials)
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=admin123

# Network Configuration
COMPOSE_PROJECT_NAME=mlflow-dev
